{
  // Cloudflare Workers（Git連携ビルド / `wrangler deploy`）用設定。
  // ビルドは Nitro の cloudflare-module プリセット（vite.config.ts で固定）で
  // .output/ に出力される。デプロイはリポジトリルートから `npx wrangler deploy`。
  // name は Cloudflare 側のプロジェクト名に合わせること。
  "name": "final-vent",
  // SSR を担う module worker のエントリ。
  "main": ".output/server/index.mjs",
  "compatibility_date": "2024-11-01",
  // Nitro 製 SSR Worker は Node 互換 API を使うため必須。
  "compatibility_flags": ["nodejs_compat"],
  // 静的資産。worker は env.ASSETS バインディング経由でこれを配信する。
  "assets": {
    "directory": ".output/public",
    "binding": "ASSETS"
  }
}

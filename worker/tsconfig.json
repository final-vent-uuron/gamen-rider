{
  // Cloudflare Workers（Durable Object）用の TypeScript 設定。
  // ルート tsconfig は DOM 型なので、Workers 型（WebSocketPair / DurableObject 等）はここで見る。
  // ../src/battle/state.ts は純粋関数で DOM/Workers どちらの型にも依存しないため両方から参照できる。
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    "types": ["@cloudflare/workers-types"],
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["**/*.ts", "../src/battle/state.ts"]
}
